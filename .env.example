# Copy to .env for local development. Set real values in the host's secret manager.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-4-5
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/ai_receptionist
MONGODB_DB=ai_receptionist
ADMIN_KEY=replace-with-a-long-random-secret
PUBLIC_URL=https://your-service.onrender.com
PORT=3000

# Stripe subscription checkout
STRIPE_API_KEY=sk_live_replace-with-restricted-secret-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-endpoint-signing-secret

# Outreach helper script
SERVER_URL=https://your-service.onrender.com

# Keep false in production. Only set true for local webhook development.
SKIP_SIGNATURE_CHECK=false
